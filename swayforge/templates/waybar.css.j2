/* {{ mark }} – don't edit. Your own rules go into ~/.config/waybar/style.css
   (below the @import line). Layout: {{ layout }} */

* {
    font-family: "{{ font }}", "Symbols Nerd Font", monospace;
    font-size: {{ s.theme.font_size + 2 }}px;
    min-height: 0;
    border: none;
    border-radius: 0;
}

tooltip {
    background: {{ c.mantle }};
    border: 1px solid {{ c.accent }};
    border-radius: {{ s.look.radius }}px;
}
tooltip label { color: {{ c.text }}; }

{% set mods = "#workspaces, #mode, #window, #clock, #cpu, #memory, #temperature, #custom-gpu, #network, #pulseaudio, #bluetooth, #battery, #backlight, #idle_inhibitor, #mpris, #tray, #custom-power, #custom-taskmanager, #custom-gamemode, #custom-osk, #custom-orn-l, #custom-orn-r, #custom-orn-c1, #custom-orn-c2" %}
{% set raised = bv.hi ~ " " ~ bv.lo ~ " " ~ bv.lo ~ " " ~ bv.hi %}
{% set sunken = bv.lo ~ " " ~ bv.hi ~ " " ~ bv.hi ~ " " ~ bv.lo %}

{% if layout in ("modern", "minimal") %}
/* ── Modern islands ─────────────────────────────────────────────── */
window#waybar { background: transparent; color: {{ c.text }}; }
{{ mods }} {
    background: {{ rgba(c.base, 0.88) }};
    border: 1px solid {{ rgba(c.surface2, 0.6) }};
    border-radius: {{ s.look.radius }}px;
    margin: 5px 3px;
    padding: 0 12px;
}
.modules-left > widget:first-child > * { margin-left: {{ s.look.gaps_outer + s.look.gaps_inner }}px; }
.modules-right > widget:last-child > * { margin-right: {{ s.look.gaps_outer + s.look.gaps_inner }}px; }

{% elif layout == "solid" %}
/* ── Solid bar ──────────────────────────────────────────────────── */
window#waybar {
    background: {{ rgba(c.base, 0.95) }};
    border-bottom: 2px solid {{ c.surface }};
    color: {{ c.text }};
}
{{ mods }} { margin: 0 1px; padding: 0 12px; }
#cpu, #memory, #temperature, #custom-gpu, #network, #pulseaudio, #bluetooth, #battery, #backlight {
    border-left: 1px solid {{ c.surface2 }};
}

{% elif layout == "win98" %}
/* ── Classic 98: bevelled 3D buttons, sunken tray ───────────────── */
window#waybar {
    background: {{ bv.face }};
    border-top: 2px solid {{ bv.hi }};
    color: {{ c.text }};
}
{{ mods }} { padding: 0 6px; margin: 0; background: transparent; }
#custom-start {
    font-weight: bold;
    padding: 0 10px;
    margin: 3px 4px 3px 3px;
    background: {{ bv.face }};
    border-style: solid;
    border-width: 2px;
    border-color: {{ raised }};
    color: {{ c.text }};
}
#custom-start:hover { border-color: {{ sunken }}; background: {{ bv.pressed }}; }
#workspaces { margin: 3px 4px; padding: 0; }
#workspaces button {
    padding: 0 7px;
    margin: 0 1px;
    color: {{ c.text }};
    background: {{ bv.face }};
    border-style: solid; border-width: 2px; border-color: {{ raised }};
}
#workspaces button.focused { border-color: {{ sunken }}; background: {{ bv.pressed }}; color: {{ c.accent }}; }
#workspaces button.urgent { color: {{ c.red }}; }
#taskbar { margin: 3px 2px; }
#taskbar button {
    min-width: 160px;
    padding: 0 8px;
    margin: 0 2px;
    background: {{ bv.face }};
    color: {{ c.text }};
    border-style: solid; border-width: 2px; border-color: {{ raised }};
}
#taskbar button.active {
    border-color: {{ sunken }};
    background: {{ bv.pressed }};
    font-weight: bold;
}
#status {
    margin: 3px 3px 3px 6px;
    padding: 0 4px;
    border-style: solid; border-width: 1px; border-color: {{ sunken }};
}
#custom-power {
    margin: 3px 3px 3px 0;
    padding: 0 9px;
    background: {{ bv.face }};
    border-style: solid; border-width: 2px; border-color: {{ raised }};
}
#custom-power:hover { border-color: {{ sunken }}; }

{% elif layout == "winxp" %}
/* ── Luna XP: blue taskbar, big green Start button, rounded task buttons, tray with clock ── */
{% set hi = mix(c.accent, "#ffffff", 0.32) %}
{% set mid = mix(c.accent, "#ffffff", 0.08) %}
{% set lo = mix(c.accent, "#000000", 0.18) %}
window#waybar {
    background: linear-gradient(to bottom, {{ hi }} 0%, {{ mid }} 9%, {{ c.accent }} 45%, {{ lo }} 100%);
    border-top: 1px solid {{ mix(c.accent, "#ffffff", 0.5) }};
    color: #ffffff;
}
{{ mods }} { padding: 0 6px; margin: 0; background: transparent; color: #ffffff; }
#custom-start {
    margin: 0 10px 0 0;
    padding: 0 26px 0 16px;
    font-size: {{ s.theme.font_size + 5 }}px;
    font-weight: bold;
    font-style: italic;
    color: #ffffff;
    text-shadow: 1px 1px 2px rgba(0, 40, 0, 0.75);
    background: linear-gradient(to bottom, {{ mix(c.green, "#ffffff", 0.45) }} 0%, {{ mix(c.green, "#ffffff", 0.1) }} 14%, {{ c.green }} 55%, {{ mix(c.green, "#000000", 0.22) }} 100%);
    border: 1px solid {{ mix(c.green, "#000000", 0.5) }};
    border-left: none;
    border-radius: 0 18px 18px 0;
    box-shadow: 2px 0 5px rgba(0, 0, 0, 0.45), inset 0 1px 0 {{ rgba("#ffffff", 0.45) }};
}
#custom-start:hover {
    background: linear-gradient(to bottom, {{ mix(c.green, "#ffffff", 0.6) }} 0%, {{ mix(c.green, "#ffffff", 0.25) }} 14%, {{ mix(c.green, "#ffffff", 0.1) }} 55%, {{ c.green }} 100%);
}
#custom-start:active { background: {{ mix(c.green, "#000000", 0.2) }}; }
#workspaces { margin: 4px 6px 4px 0; padding: 0; }
#workspaces button {
    padding: 0 8px; margin: 0 2px;
    color: #ffffff;
    background: {{ rgba("#ffffff", 0.14) }};
    border: 1px solid {{ rgba("#000000", 0.28) }};
    border-radius: 3px;
}
#workspaces button:hover { background: {{ rgba("#ffffff", 0.28) }}; }
#workspaces button.focused { background: {{ rgba("#000000", 0.28) }}; box-shadow: inset 1px 1px 3px {{ rgba("#000000", 0.5) }}; font-weight: bold; }
#workspaces button.urgent { background: {{ c.orange }}; }
#taskbar { margin: 3px 2px; }
#taskbar button {
    min-width: 170px;
    padding: 0 10px; margin: 0 2px;
    color: #ffffff;
    background: linear-gradient(to bottom, {{ mix(c.accent, "#ffffff", 0.42) }}, {{ mix(c.accent, "#ffffff", 0.22) }} 50%, {{ mix(c.accent, "#ffffff", 0.14) }});
    border: 1px solid {{ mix(c.accent, "#000000", 0.4) }};
    border-radius: 3px;
    text-shadow: 1px 1px 1px {{ rgba("#000000", 0.35) }};
}
#taskbar button:hover { background: linear-gradient(to bottom, {{ mix(c.accent, "#ffffff", 0.55) }}, {{ mix(c.accent, "#ffffff", 0.35) }}); }
#taskbar button.active {
    background: linear-gradient(to bottom, {{ mix(c.accent, "#000000", 0.28) }}, {{ mix(c.accent, "#000000", 0.12) }});
    box-shadow: inset 1px 1px 4px {{ rgba("#000000", 0.55) }};
    font-weight: bold;
}
#status {
    margin: 0 0 0 6px;
    padding: 0 12px 0 10px;
    background: linear-gradient(to bottom, {{ mix(c.accent, "#7fd0ff", 0.55) }}, {{ mix(c.accent, "#2aa0f0", 0.45) }} 12%, {{ mix(c.accent, "#1590e8", 0.4) }} 85%, {{ mix(c.accent, "#000000", 0.1) }});
    border-left: 1px solid {{ mix(c.accent, "#000000", 0.45) }};
    box-shadow: inset 1px 0 0 {{ rgba("#ffffff", 0.35) }}, inset 0 1px 0 {{ rgba("#ffffff", 0.3) }};
}
#status #clock { padding: 0 6px; }
#custom-power {
    margin: 4px 6px 4px 6px;
    padding: 0 9px;
    color: #ffffff;
    background: linear-gradient(to bottom, {{ mix(c.red, "#ffffff", 0.35) }}, {{ c.red }} 60%, {{ mix(c.red, "#000000", 0.2) }});
    border: 1px solid {{ mix(c.red, "#000000", 0.5) }};
    border-radius: 3px;
}
#custom-power:hover { background: {{ mix(c.red, "#ffffff", 0.2) }}; }

{% elif layout == "win7" %}
/* ── Glass 7: translucent gradient, start orb, icon task buttons ──── */
window#waybar {
    background: linear-gradient(to bottom, {{ rgba(bv.hi, 0.55) }}, {{ rgba(c.base, 0.82) }} 45%, {{ rgba(c.crust, 0.94) }});
    border-top: 1px solid {{ rgba(c.text, 0.35) }};
    color: {{ c.text }};
}
{{ mods }} { padding: 0 6px; margin: 0; background: transparent; }
#custom-start {
    min-width: 34px;
    margin: 3px 10px 3px 8px;
    padding: 0 6px;
    border-radius: 9999px;
    font-size: {{ s.theme.font_size + 6 }}px;
    color: {{ c.crust }};
    background: radial-gradient(circle, {{ mix(c.accent, "#ffffff", 0.55) }}, {{ c.accent }} 55%, {{ c.accent2 }});
    border: 1px solid {{ rgba(c.text, 0.5) }};
    box-shadow: 0 0 8px {{ rgba(c.accent, 0.6) }};
}
#workspaces button { padding: 0 8px; margin: 4px 1px; border-radius: 4px; color: {{ c.subtext }}; }
#workspaces button.focused { color: {{ c.text }}; background: {{ rgba(c.text, 0.12) }}; }
#taskbar button {
    padding: 0 12px;
    margin: 3px 2px;
    border-radius: 4px;
    border: 1px solid {{ rgba(c.text, 0.22) }};
    background: linear-gradient(to bottom, {{ rgba(c.text, 0.20) }}, {{ rgba(c.text, 0.05) }} 50%, {{ rgba(c.crust, 0.15) }});
}
#taskbar button.active {
    background: linear-gradient(to bottom, {{ rgba(c.accent, 0.55) }}, {{ rgba(c.accent, 0.20) }} 50%, {{ rgba(c.accent2, 0.30) }});
    box-shadow: inset 0 0 6px {{ rgba(c.accent, 0.8) }};
}
#status { padding: 0 6px; }
#custom-power { padding: 0 12px; }

{% elif layout == "win11" %}
/* ── Modern 11: frosted bar, centered rounded start + task buttons ───── */
window#waybar {
    background: {{ rgba(c.mantle, 0.82) }};
    border-top: 1px solid {{ rgba(c.text, 0.10) }};
    color: {{ c.text }};
}
{{ mods }} { padding: 0 8px; margin: 0; background: transparent; }
#custom-start {
    min-width: 34px; margin: 6px 4px; padding: 0 10px;
    border-radius: 6px; color: {{ c.accent }};
    font-size: {{ s.theme.font_size + 4 }}px;
}
#custom-start:hover, #taskbar button:hover { background: {{ rgba(c.text, 0.10) }}; }
#workspaces { margin: 6px 8px; }
#workspaces button { padding: 0 10px; margin: 0 2px; border-radius: 6px; color: {{ c.subtext }}; }
#workspaces button.focused { color: {{ c.text }}; background: {{ rgba(c.text, 0.12) }}; }
#taskbar button {
    padding: 0 12px; margin: 5px 2px; border-radius: 6px;
    border-bottom: 3px solid transparent; background: transparent;
}
#taskbar button.active {
    background: {{ rgba(c.text, 0.10) }};
    border-bottom: 3px solid {{ c.accent }};
}
#status { padding: 0 8px; margin: 6px 4px; border-radius: 6px; }
#status:hover { background: {{ rgba(c.text, 0.08) }}; }
#custom-power { padding: 0 12px; }

{% elif layout == "touch" %}
/* ── Touch: tall bar, big rounded tap targets, no hover-only affordances ── */
* { font-size: {{ s.theme.font_size + 6 }}px; }
window#waybar {
    background: {{ rgba(c.mantle, 0.97) }};
    border-top: 2px solid {{ c.accent }};
    color: {{ c.text }};
}
{{ mods }} { padding: 0 18px; margin: 6px 5px; border-radius: 14px; background: {{ c.surface }}; min-width: 28px; }
#custom-start, #custom-osk { color: {{ c.crust }}; background: {{ c.accent }}; padding: 0 24px; font-size: {{ s.theme.font_size + 10 }}px; }
#custom-osk { background: {{ c.accent2 }}; color: {{ c.text }}; }
#workspaces { padding: 0; background: transparent; margin: 6px 5px; }
#workspaces button { min-width: 56px; margin: 0 4px; padding: 0 16px; border-radius: 14px; background: {{ c.surface }}; color: {{ c.text }}; }
#workspaces button.focused { background: {{ c.accent }}; color: {{ c.crust }}; }
#status { background: transparent; padding: 0; margin: 0; }
#custom-power { background: {{ c.red }}; color: {{ c.crust }}; padding: 0 24px; }
#tray { min-width: 48px; }

{% elif layout == "wired" %}
/* ── Wired: text only, no frills ────────────────────────────────── */
window#waybar {
    background: {{ c.crust }};
    border-bottom: 1px solid {{ c.accent }};
    color: {{ c.text }};
}
{{ mods }} { padding: 0 4px; margin: 0; background: transparent; }
#workspaces button { padding: 0 2px; color: {{ c.overlay }}; }
#workspaces button.focused { color: {{ c.accent }}; background: transparent; }
#window { color: {{ c.subtext }}; padding-left: 10px; }
#clock { color: {{ c.accent }}; font-weight: normal; }

{% elif layout == "cathedral" %}
/* ── Cathedral: stone bar, double rule in the accent, serif numerals, ornaments ── */
* { font-family: "DejaVu Serif", "{{ font }}", "Symbols Nerd Font", serif; }
window#waybar {
    background: linear-gradient(to bottom, {{ c.surface }}, {{ c.crust }});
    border-top: 1px solid {{ rgba(c.text, 0.18) }};
    border-bottom: 4px double {{ c.accent }};
    color: {{ c.text }};
}
{{ mods }} { margin: 4px 0; padding: 0 14px; }
.modules-left, .modules-right { padding: 0 8px; }
#workspaces { padding: 0 6px; border-right: 1px solid {{ rgba(c.text, 0.15) }}; }
#workspaces button { font-size: {{ s.theme.font_size + 3 }}px; letter-spacing: 1px; padding: 0 9px;
    color: {{ c.subtext }}; background: transparent; border-bottom: 2px solid transparent; }
#workspaces button.focused { color: {{ c.text }}; border-bottom: 2px solid {{ c.accent }};
    background: linear-gradient(to top, {{ rgba(c.accent, 0.28) }}, transparent); }
#workspaces button:hover { color: {{ c.text }}; background: {{ rgba(c.text, 0.06) }}; }
#clock { font-size: {{ s.theme.font_size + 4 }}px; letter-spacing: 3px; color: {{ c.text }};
    padding: 0 26px; border-left: 3px double {{ rgba(c.accent, 0.7) }}; border-right: 3px double {{ rgba(c.accent, 0.7) }}; }
#cpu, #memory, #temperature, #custom-gpu, #network, #pulseaudio, #bluetooth, #battery, #backlight, #mpris {
    color: {{ c.subtext }}; border-left: 1px solid {{ rgba(c.text, 0.12) }}; }
#custom-power { font-size: {{ s.theme.font_size + 6 }}px; color: {{ c.accent }}; padding: 0 16px; }
#custom-orn-l, #custom-orn-r, #custom-orn-c1, #custom-orn-c2 { padding: 0 10px; letter-spacing: 4px; border: none; }
#custom-orn-c1, #custom-orn-c2 { padding: 0 4px; }
#custom-power:hover { color: {{ c.text }}; text-shadow: 0 0 6px {{ c.accent }}; }

{% elif layout == "sidebar" %}
/* ── Sidebar ────────────────────────────────────────────────────── */
window#waybar {
    background: {{ rgba(c.base, 0.95) }};
    border-right: 2px solid {{ c.surface }};
    color: {{ c.text }};
}
{{ mods }} { padding: 6px 0; margin: 2px 4px; border-radius: {{ s.look.radius }}px; }
#workspaces button { padding: 4px 0; }
#clock { font-weight: bold; padding: 8px 0; }
{% endif %}

/* ── Shared ─────────────────────────────────────────────────────── */
{% if layout not in ("win98", "winxp", "cathedral", "win11", "touch") %}
#workspaces button {
    color: {{ c.subtext }};
    background: transparent;
}
#workspaces button:hover { background: {{ c.surface }}; color: {{ c.text }}; }
{% if layout not in ("wired", "win7") %}
#workspaces button { padding: 0 8px; margin: 4px 1px; border-radius: {{ [s.look.radius - 2, 0] | max }}px; }
{% if s.look.radius == 0 %}
#workspaces button.focused { background: {{ c.surface }}; color: {{ c.accent }}; box-shadow: inset 0 -3px {{ c.accent }}; }
{% else %}
#workspaces button.focused { background: {{ c.accent }}; color: {{ c.crust }}; }
{% endif %}
{% endif %}
#workspaces button.urgent { background: {{ c.red }}; color: {{ c.crust }}; }
{% endif %}

#mode { background: {{ c.yellow }}; color: {{ c.crust }}; }
#window { color: {{ c.subtext }}; }
window#waybar.empty #window { background: transparent; border-color: transparent; }
{% if layout not in ("win98", "winxp", "win7", "win11", "touch", "wired", "cathedral") %}
#clock { color: {{ c.accent }}; font-weight: bold; }
#cpu { color: {{ c.blue }}; }
#memory { color: {{ c.magenta }}; }
#custom-gpu { color: {{ c.red }}; }
#temperature { color: {{ c.orange }}; }
#network { color: {{ c.cyan }}; }
#pulseaudio { color: {{ c.yellow }}; }
#bluetooth { color: {{ c.blue }}; }
#backlight { color: {{ c.yellow }}; }
#battery { color: {{ c.green }}; }
#mpris { color: {{ c.green }}; }
#custom-taskmanager { color: {{ c.cyan }}; }
#custom-taskmanager:hover { background: {{ c.cyan }}; color: {{ c.crust }}; }
#custom-power { color: {{ c.red }}; }
#custom-power:hover { background: {{ c.red }}; color: {{ c.crust }}; }
{% endif %}
#temperature.critical { background: {{ c.red }}; color: {{ c.crust }}; }
#network.disconnected { color: {{ c.red }}; }
#pulseaudio.muted, #pulseaudio.source-muted { color: {{ c.overlay }}; }
#bluetooth.off, #bluetooth.disabled { color: {{ c.overlay }}; }
#battery.warning { color: {{ c.yellow }}; }
#battery.critical:not(.charging) { background: {{ c.red }}; color: {{ c.crust }}; }
#idle_inhibitor { color: {{ c.overlay }}; }
#idle_inhibitor.activated { color: {{ c.accent }}; }
#custom-gamemode { color: {{ c.overlay }}; }
#custom-gamemode.on { background: {{ c.accent }}; color: {{ c.crust }}; }
#tray > .needs-attention { background: {{ c.red }}; }
