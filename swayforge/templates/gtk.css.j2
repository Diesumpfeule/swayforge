/* {{ mark }} – adapts adw-gtk3/libadwaita colours to the theme. */
@define-color accent_color {{ c.accent }};
@define-color accent_bg_color {{ c.accent }};
@define-color accent_fg_color {{ c.crust }};
@define-color window_bg_color {{ c.base }};
@define-color window_fg_color {{ c.text }};
@define-color view_bg_color {{ c.mantle }};
@define-color view_fg_color {{ c.text }};
@define-color headerbar_bg_color {{ c.mantle }};
@define-color headerbar_fg_color {{ c.text }};
@define-color headerbar_backdrop_color {{ c.base }};
@define-color sidebar_bg_color {{ c.mantle }};
@define-color sidebar_fg_color {{ c.text }};
@define-color card_bg_color {{ c.surface }};
@define-color card_fg_color {{ c.text }};
@define-color popover_bg_color {{ c.surface }};
@define-color popover_fg_color {{ c.text }};
@define-color dialog_bg_color {{ c.base }};
@define-color dialog_fg_color {{ c.text }};
@define-color destructive_bg_color {{ c.red }};
@define-color success_bg_color {{ c.green }};
@define-color warning_bg_color {{ c.yellow }};
@define-color error_bg_color {{ c.red }};
{% if layout == "win98" %}

/* Classic 98: bevelled buttons, sunken entries, square corners */
button, .button, combobox button, spinbutton button {
    border-radius: 0;
    border-style: solid; border-width: 2px;
    border-color: {{ bv.hi }} {{ bv.lo }} {{ bv.lo }} {{ bv.hi }};
    background-image: none; background-color: {{ bv.face }};
    box-shadow: none;
}
button:active, button:checked, .button:active {
    border-color: {{ bv.lo }} {{ bv.hi }} {{ bv.hi }} {{ bv.lo }};
    background-color: {{ bv.pressed }};
}
entry, spinbutton, textview, treeview.view, scrolledwindow.frame {
    border-radius: 0;
    border-style: solid; border-width: 2px;
    border-color: {{ bv.lo }} {{ bv.hi }} {{ bv.hi }} {{ bv.lo }};
    box-shadow: none;
}
headerbar, .titlebar {
    border-radius: 0;
    background-image: linear-gradient(to right, {{ bv.title }}, {{ bv.title2 }});
    color: {{ c.crust }};
}
menu, popover contents, .menu { border-radius: 0; border: 2px solid {{ bv.hi }}; }
{% elif layout == "winxp" %}

/* Luna XP: beige buttons with an orange hover / blue focus ring, blue gradient title bars */
button, .button, combobox button, spinbutton button {
    border-radius: 3px;
    border: 1px solid {{ mix(c.accent, "#000000", 0.45) }};
    background-image: linear-gradient(to bottom, #ffffff, {{ c.base }} 70%, {{ c.mantle }});
    color: {{ c.text }};
    box-shadow: none;
}
button:hover, .button:hover { box-shadow: inset 0 0 0 2px {{ c.orange }}; }
button:focus, .button:focus { box-shadow: inset 0 0 0 2px {{ c.accent2 }}; }
button:active, button:checked, .button:active {
    background-image: linear-gradient(to bottom, {{ c.mantle }}, {{ c.base }});
    box-shadow: inset 1px 1px 3px {{ rgba("#000000", 0.35) }};
}
entry, spinbutton, textview, treeview.view {
    border-radius: 2px;
    border: 1px solid {{ mix(c.accent, c.surface2, 0.4) }};
    background-color: {{ c.surface }};
    box-shadow: none;
}
headerbar, .titlebar {
    border-radius: 8px 8px 0 0;
    border: none;
    color: #ffffff;
    font-weight: bold;
    text-shadow: 1px 1px 1px {{ mix(c.accent, "#000000", 0.6) }};
    background-image: linear-gradient(to bottom, {{ mix(c.accent, "#ffffff", 0.35) }}, {{ c.accent }} 12%, {{ c.accent }} 80%, {{ mix(c.accent, "#000000", 0.2) }});
}
headerbar button { color: #ffffff; background-image: none; border-color: {{ rgba("#ffffff", 0.6) }}; }
menu, popover contents, .menu { border-radius: 0; border: 1px solid {{ c.surface2 }}; }
menuitem:hover, row:selected { background-color: {{ c.accent2 }}; color: #ffffff; }
{% elif layout == "win7" %}

/* Glass 7: soft gradients, small radius */
button, .button {
    border-radius: 3px;
    border: 1px solid {{ rgba(c.text, 0.25) }};
    background-image: linear-gradient(to bottom, {{ rgba(c.text, 0.16) }}, {{ rgba(c.text, 0.04) }} 50%, {{ rgba(c.crust, 0.12) }});
}
button:hover { box-shadow: inset 0 0 6px {{ rgba(c.accent, 0.6) }}; }
headerbar, .titlebar {
    background-image: linear-gradient(to bottom, {{ rgba(bv.hi, 0.9) }}, {{ c.base }});
}
{% elif layout == "win11" %}

/* Modern 11: rounded, soft borders */
button, .button, entry { border-radius: 6px; border: 1px solid {{ rgba(c.text, 0.14) }}; }
button:hover { background-color: {{ rgba(c.text, 0.08) }}; }
{% elif layout == "touch" %}

/* Touch: big targets */
button, .button, entry, spinbutton { min-height: 44px; min-width: 44px; border-radius: 12px; padding: 6px 14px; }
menuitem, row, treeview.view { min-height: 44px; }
scrollbar slider { min-width: 14px; min-height: 14px; }
{% elif layout == "wired" %}

/* Wired: flat, square, thin accent lines */
* { border-radius: 0; }
button, entry { box-shadow: none; border: 1px solid {{ c.surface2 }}; }
button:focus, entry:focus { border-color: {{ c.accent }}; }
{% elif s.look.radius == 0 %}

* { border-radius: 0; }
{% endif %}
