<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160">
  <defs>
    <radialGradient id="glow" cx="0.5" cy="0.45" r="0.75">
      <stop offset="0" stop-color="{{ c.surface }}"/>
      <stop offset="0.55" stop-color="{{ c.base }}"/>
      <stop offset="1" stop-color="{{ c.crust }}"/>
    </radialGradient>
    <radialGradient id="vignette" cx="0.5" cy="0.5" r="0.72">
      <stop offset="0.6" stop-color="#000" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity="0.85"/>
    </radialGradient>
    <pattern id="scan" width="8" height="8" patternUnits="userSpaceOnUse">
      <rect width="8" height="3" fill="#000" fill-opacity="0.35"/>
    </pattern>
    <filter id="bloom" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <rect width="3840" height="2160" fill="url(#glow)"/>
  <g font-family="Terminess Nerd Font, Terminus, monospace" font-size="54" fill="{{ c.accent }}" filter="url(#bloom)">
    <text x="260" y="1380" fill-opacity="0.85">SWAYFORGE BIOS v2.0   (C) {{ theme.label.split(" (")[0] | upper }} SYSTEMS</text>
    <text x="260" y="1470" fill-opacity="0.6">CPU ............................. OK</text>
    <text x="260" y="1540" fill-opacity="0.6">MEMORY TEST ..................... OK</text>
    <text x="260" y="1610" fill-opacity="0.6">GPU ............................. OK</text>
    <text x="260" y="1680" fill-opacity="0.6">LOADING WAYLAND COMPOSITOR ...... OK</text>
    <text x="260" y="1800" fill-opacity="0.9">&gt; READY <tspan fill-opacity="0.95">█</tspan></text>
  </g>
  <g stroke="{{ c.accent }}" stroke-opacity="0.12" stroke-width="2" fill="none">
    <rect x="200" y="160" width="3440" height="1840" rx="0"/>
    <line x1="200" y1="1260" x2="3640" y2="1260"/>
  </g>
  <rect width="3840" height="2160" fill="url(#scan)"/>
  <rect width="3840" height="2160" fill="url(#vignette)"/>
</svg>
