<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160">
  <defs>
    <radialGradient id="v" cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.5" stop-color="#000" stop-opacity="0"/>
      <stop offset="1" stop-color="#000" stop-opacity="0.9"/>
    </radialGradient>
    <pattern id="scan" width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="6" height="2" fill="#000" fill-opacity="0.45"/>
    </pattern>
  </defs>
  <rect width="3840" height="2160" fill="{{ c.base }}"/>
  <g fill="{{ c.text }}">
{% for x, y, r, o in extras.noise %}
    <rect x="{{ x }}" y="{{ y }}" width="{{ r }}" height="1" opacity="{{ '%.2f' % o }}"/>
{% endfor %}
  </g>
  <g stroke="{{ c.accent2 }}" stroke-opacity="0.22" stroke-width="2">
{% for i, j in extras.edges %}
    <line x1="{{ extras.nodes[i][0] }}" y1="{{ extras.nodes[i][1] }}" x2="{{ extras.nodes[j][0] }}" y2="{{ extras.nodes[j][1] }}"/>
{% endfor %}
  </g>
  <g fill="{{ c.accent }}">
{% for x, y in extras.nodes %}
    <rect x="{{ x - 5 }}" y="{{ y - 5 }}" width="10" height="10" opacity="{{ '0.9' if loop.index % 7 == 0 else '0.35' }}"/>
{% endfor %}
  </g>
  <g font-family="{{ font }}, monospace" fill="{{ c.accent }}">
{% for line in banner("connected") %}
    <text x="260" y="{{ 780 + loop.index0 * 92 }}" font-size="96" fill-opacity="0.85" xml:space="preserve">{{ line }}</text>
{% endfor %}
    <text x="260" y="1380" font-size="40" fill="{{ c.subtext }}" xml:space="preserve">node 07 :: signal ok :: latency 0.3 ms :: uplink ████████░░</text>
    <text x="260" y="1440" font-size="40" fill="{{ c.subtext }}" xml:space="preserve">&gt; _</text>
  </g>
  <rect width="3840" height="2160" fill="url(#scan)"/>
  <rect width="3840" height="2160" fill="url(#v)"/>
</svg>
