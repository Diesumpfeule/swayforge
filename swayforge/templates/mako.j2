# {{ mark }} – changes will be overwritten.
font={{ font }} {{ s.theme.font_size + (5 if layout == 'touch' else 0) }}
background-color={{ (c.crust if layout == 'dread' else '#ffffe1' if layout == 'winxp' else bv.face if layout == 'win98' else c.crust if layout == 'wired' else c.base) }}{{ '' if layout == 'winxp' else uhex(0.93) }}
{% if layout == 'wired' %}
format=<b>// %s</b>\n%b
{% elif layout == 'dread' %}
format=<span color="{{ c.accent }}">▌</span> <b>%s</b>\n<span color="{{ c.subtext }}">%b</span>
{% elif layout == 'cathedral' %}
format=<span color="{{ c.accent }}">☩ ❦ ✠ ❦ ☩</span>\n<b>%s</b>\n%b\n<span color="{{ c.accent }}">· · † · ·</span>
{% endif %}
text-color={{ '#000000' if layout == 'winxp' else c.text }}
border-color={{ c.surface2 if layout in ('dread', 'glass') else '#000000' if layout == 'winxp' else bv.hi if layout == 'win98' else c.accent }}
progress-color=over {{ c.surface2 }}
border-size={{ 1 if layout in ('wired', 'win7', 'winxp', 'dread', 'glass') else 3 if layout == 'cathedral' else 2 }}
border-radius={{ 8 if layout == 'winxp' else 6 if layout in ('win7', 'win11') else 16 if layout == 'touch' else s.look.radius }}
padding={{ '22,26' if layout == 'touch' else '12,16' }}
margin={{ s.look.gaps_inner + s.look.gaps_outer }}
width={{ 560 if layout == 'touch' else 380 }}
max-visible=5
default-timeout=6000
icons=1
max-icon-size=48
layer=overlay
anchor={{ "bottom-right" if layout in ('win98', 'winxp', 'win7', 'win11', 'touch') else "top-right" }}

{% if s.sound.enabled and s.sound.notify %}
on-notify=exec pw-play "$HOME/.local/share/sounds/swayforge/stereo/message-new-instant.wav"

{% endif %}
[category=osd]
default-timeout=1400
format=<b>%s</b>

[urgency=low]
border-color={{ c.surface2 }}

[urgency=high]
{% if s.sound.enabled and s.sound.notify %}
on-notify=exec pw-play "$HOME/.local/share/sounds/swayforge/stereo/dialog-warning.wav"
{% endif %}
border-color={{ c.red }}
default-timeout=0

[mode=do-not-disturb]
invisible=1
