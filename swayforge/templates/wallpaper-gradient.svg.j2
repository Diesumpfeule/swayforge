<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{ c.base }}"/>
      <stop offset="1" stop-color="{{ c.crust }}"/>
    </linearGradient>
    <radialGradient id="g1" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="{{ c.accent }}" stop-opacity="0.35"/>
      <stop offset="1" stop-color="{{ c.accent }}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="g2" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="{{ c.accent2 }}" stop-opacity="0.28"/>
      <stop offset="1" stop-color="{{ c.accent2 }}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="g3" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="{{ c.cyan }}" stop-opacity="0.18"/>
      <stop offset="1" stop-color="{{ c.cyan }}" stop-opacity="0"/>
    </radialGradient>
    <pattern id="dots" width="64" height="64" patternUnits="userSpaceOnUse">
      <circle cx="32" cy="32" r="2.2" fill="{{ c.text }}" fill-opacity="0.06"/>
    </pattern>
  </defs>
  <rect width="3840" height="2160" fill="url(#bg)"/>
  <circle cx="3000" cy="520" r="1300" fill="url(#g1)"/>
  <circle cx="700" cy="1750" r="1400" fill="url(#g2)"/>
  <circle cx="1950" cy="1200" r="900" fill="url(#g3)"/>
  <rect width="3840" height="2160" fill="url(#dots)"/>
  <g fill="none" stroke="{{ c.accent }}" stroke-opacity="0.18" stroke-width="3">
    <path d="M -100 1500 C 900 1200, 1500 1900, 2400 1500 S 3600 900, 4000 1200"/>
    <path d="M -100 1580 C 900 1280, 1500 1980, 2400 1580 S 3600 980, 4000 1280" stroke-opacity="0.10"/>
  </g>
</svg>
