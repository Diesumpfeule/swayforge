# ╭──────────────────────────────────────────────────────────────╮
# │  swayforge generated – changes here will be overwritten.     │
# │  Your own tweaks go into: ~/.config/sway/custom.conf         │
# │  (loaded last, so it overrides everything here)              │
# ╰──────────────────────────────────────────────────────────────╯

set $mod {{ s.general.mod }}
set $term {{ term_cmd }}

# ── Look ─────────────────────────────────────────────────────────
{% if s.look.title_bars %}
font pango:{{ s.theme.font }} {{ s.theme.font_size }}
{% else %}
# No title bars: the font only sizes the strip of tabbed/stacked layouts → keep it a hairline
font pango:{{ s.theme.font }} 1
titlebar_padding 1 1
titlebar_border_thickness 0
{% endif %}
{% if s.look.title_bars %}
default_border normal {{ s.look.border }}
titlebar_padding 8 4
title_align center
{% else %}
default_border pixel {{ s.look.border }}
{% endif %}
default_floating_border pixel {{ s.look.border }}
gaps inner {{ s.look.gaps_inner }}
gaps outer {{ s.look.gaps_outer }}
smart_gaps {{ "on" if s.look.smart_gaps else "off" }}
hide_edge_borders --i3 {{ "smart" if s.look.smart_gaps else "none" }}

#                       border       background   text         indicator    child border
client.focused          {{ c.accent }}   {{ c.accent }}   {{ on(c.accent, c.crust) }}    {{ c.accent2 }}   {{ c.accent }}
client.focused_inactive {{ c.surface2 }} {{ c.surface }}  {{ c.text }}     {{ c.surface2 }}  {{ c.surface2 }}
client.unfocused        {{ c.surface }}  {{ c.base }}     {{ c.subtext }}  {{ c.surface }}   {{ c.surface }}
client.urgent           {{ c.red }}      {{ c.red }}      {{ on(c.red, c.crust) }}    {{ c.red }}       {{ c.red }}
client.background       {{ c.base }}
{% if si.swayfx %}

# ── SwayFX effects ───────────────────────────────────────────────
corner_radius {{ s.look.radius }}
smart_corner_radius enable
shadows {{ "enable" if s.look.fx_shadows else "disable" }}
shadow_blur_radius 20
shadow_color {{ c.crust }}cc
blur {{ "enable" if s.look.fx_blur else "disable" }}
blur_passes 3
blur_radius 5
default_dim_inactive {{ s.look.fx_dim_inactive }}
layer_effects "waybar" {{ "blur disable" if ui < 1 else "blur enable" }}; {{ "shadows disable" if ui < 1 else "shadows enable" }}
layer_effects "rofi" {{ "blur disable" if ui < 1 else "blur enable" }}; {{ "shadows disable" if ui < 1 else "shadows enable" }}
layer_effects "notifications" {{ "blur disable" if ui < 1 else "blur enable" }}; {{ "shadows disable" if ui < 1 else "shadows enable" }}
{% endif %}

seat seat0 xcursor_theme {{ s.theme.cursor_theme }} {{ s.theme.cursor_size }}

# ── Wallpaper & outputs ────────────────────────────────────
{% if wallpaper_kind == "solid" %}
output * bg {{ c.base }} solid_color
exec_always sh -c "pkill -x mpvpaper; pkill -f '[l]ivewall guard'; true"
{% elif wallpaper_kind == "video" %}
output * bg {{ c.base }} solid_color
exec_always sh {{ gen_dir }}/livewall.sh
{% else %}
exec_always sh -c "pkill -x mpvpaper; pkill -f '[l]ivewall guard'; true"
output * bg "{{ wallpaper_path }}" fill {{ c.base }}
{% endif %}
{% for name, o in outputs %}
output "{{ name }}" {
{% if o.get("enabled", True) %}
{% if o.get("mode") %}    mode {{ o.mode }}
{% endif %}{% if o.get("pos") %}    position {{ o.pos }}
{% endif %}{% if o.get("scale") %}    scale {{ o.scale }}
{% endif %}{% if o.get("transform") and o.transform != "normal" %}    transform {{ o.transform }}
{% endif %}    adaptive_sync {{ "on" if o.get("adaptive_sync") else "off" }}
    allow_tearing {{ "yes" if s.display.allow_tearing else "no" }}
{% else %}
    disable
{% endif %}
}
{% endfor %}
{% if s.display.primary %}
# Main screen: workspace 1 opens here (games get it as primary via xrandr in `swayforge session`)
workspace 1 output "{{ s.display.primary }}"
{% endif %}
{% if not outputs and s.display.allow_tearing %}
output * allow_tearing yes
{% endif %}

# ── Input ──────────────────────────────────────────────────────
input type:keyboard {
    xkb_layout {{ s.input.kb_layout }}
{% if s.input.kb_variant %}    xkb_variant {{ s.input.kb_variant }}
{% endif %}{% if s.input.kb_options %}    xkb_options {{ s.input.kb_options }}
{% endif %}    xkb_numlock {{ "enabled" if s.input.numlock else "disabled" }}
    repeat_rate {{ s.input.repeat_rate }}
    repeat_delay {{ s.input.repeat_delay }}
}
input type:pointer {
    accel_profile {{ s.input.mouse_accel_profile }}
    pointer_accel {{ s.input.mouse_speed }}
}
input type:touchpad {
    tap {{ "enabled" if s.input.touchpad_tap else "disabled" }}
    natural_scroll {{ "enabled" if s.input.touchpad_natural else "disabled" }}
    dwt {{ "enabled" if s.input.touchpad_dwt else "disabled" }}
    middle_emulation enabled
}

# ── Behaviour ────────────────────────────────────────────────────
focus_follows_mouse yes
mouse_warping output
floating_modifier $mod normal
workspace_auto_back_and_forth yes
focus_on_window_activation smart

# ── Shortcuts ─────────────────────────────────────────────────
{% for label, key, cmd in keys %}
# {{ label }}
bindsym {{ key }} {{ cmd }}
{% endfor %}

# Move focus and windows: vim keys (h j k l) and arrow keys
{% for k, d in [("h", "left"), ("j", "down"), ("k", "up"), ("l", "right"),
                ("Left", "left"), ("Down", "down"), ("Up", "up"), ("Right", "right")] %}
{% if ("$mod+" ~ k) not in used_keys %}
bindsym $mod+{{ k }} focus {{ d }}
{% endif %}
{% if ("$mod+Shift+" ~ k) not in used_keys %}
bindsym $mod+Shift+{{ k }} move {{ d }}
{% endif %}
{% endfor %}

# Workspaces
{% for n in range(1, 11) %}
bindsym $mod+{{ n % 10 }} workspace number {{ n }}
bindsym $mod+Shift+{{ n % 10 }} move container to workspace number {{ n }}
{% endfor %}

# Media, volume and brightness keys with on-screen display (work while locked too)
bindsym --locked XF86AudioRaiseVolume exec {{ sf }} osd volume +5
bindsym --locked XF86AudioLowerVolume exec {{ sf }} osd volume -5
bindsym --locked XF86AudioMute exec {{ sf }} osd volume mute
bindsym --locked XF86AudioMicMute exec {{ sf }} osd mic mute
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86MonBrightnessUp exec {{ sf }} osd brightness +5
bindsym --locked XF86MonBrightnessDown exec {{ sf }} osd brightness -5

mode "resize" {
    bindsym h resize shrink width 30px
    bindsym j resize grow height 30px
    bindsym k resize shrink height 30px
    bindsym l resize grow width 30px
    bindsym Left  resize shrink width 30px
    bindsym Down  resize grow height 30px
    bindsym Up    resize shrink height 30px
    bindsym Right resize grow width 30px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ── Window rules ────────────────────────────────────────────────
{% if s.look.tiling_only %}
# Tiling only: everything tiles – no floating windows, no tabbed/stacked containers.
workspace_layout default
for_window [all] floating disable
# exception: the CS2 chat overlay has to sit on top of the fullscreen game
for_window [title="^CS2 Chat"] floating enable, sticky enable, border none
{% else %}
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id="swayforge-start"] floating enable
for_window [app_id="swayforge-settings"] floating enable, resize set width 1180 px height 780 px, move position center
for_window [app_id="^(org\.swayforge\.Studio|swayforge-app|chrome-127\.0\.0\.1.*)$"] floating enable, resize set width 1320 px height 840 px, move position center
for_window [app_id="swayforge-btop"] floating enable, resize set width 1300 px height 820 px, move position center
for_window [app_id="swayforge-task"] floating enable, resize set width 1000 px height 600 px, move position center
for_window [app_id="nmtui"] floating enable, resize set width 900 px height 650 px, move position center
for_window [app_id="pavucontrol"] floating enable, resize set width 900 px height 600 px
for_window [app_id="nm-connection-editor"] floating enable
for_window [title="^CS2 Chat"] floating enable, sticky enable, border none
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="org.keepassxc.KeePassXC" title="^(?!.*KeePassXC$)"] floating enable
for_window [app_id="imv"] floating enable
for_window [app_id="swappy"] floating enable
for_window [title="(?:Open|Save) (?:File|Folder|As)"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [class="steam" title="^(?!Steam$).*"] floating enable
{% endif %}
for_window [class="steam_app_.*"] allow_tearing {{ "yes" if s.display.allow_tearing else "no" }}
for_window [app_id="gamescope"] allow_tearing {{ "yes" if s.display.allow_tearing else "no" }}
for_window [app_id="swayforge-saver"] fullscreen enable, border none
{% if s.power.inhibit_fullscreen %}
for_window [all] inhibit_idle fullscreen
for_window [app_id="swayforge-saver"] inhibit_idle none
{% endif %}

# ── Autostart ────────────────────────────────────────────────────
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
exec lxqt-policykit-agent
{% if not ext_shell %}
exec_always sh -c 'pgrep -x mako >/dev/null || exec mako'
{% endif %}
{% if s.sound.enabled and s.sound.login %}
exec sh -c 'sleep 2; pw-play "$HOME/.local/share/sounds/swayforge/stereo/desktop-login.wav"'
{% endif %}
exec nm-applet --indicator
{% if si.bluetooth %}
exec blueman-applet
{% endif %}
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec_always {{ sf }} session
{% if ext_shell %}
# {{ ext_shell }} runs the bar + notifications now (Settings → Layout → switch back)
exec_always sh -c 'pkill -x waybar; pkill -x mako; sleep 1; pgrep -x noctalia >/dev/null || pgrep -x noctalia-shell >/dev/null || pgrep -f "^quickshell.*[n]octalia" >/dev/null || exec {{ ext_shell }}'
{% else %}
exec_always sh -c 'pkill -x waybar; exec waybar'
{% endif %}
{% if s.power.nightlight %}
exec_always sh -c 'pkill -x gammastep; exec gammastep -l {{ s.power.location }} -t 6500:{{ s.power.nightlight_temp }}'
{% else %}
exec_always pkill -x gammastep
{% endif %}
{% if cs2_watcher %}
exec_always {{ cs2_watcher }}
# CS2 write-back box (needs the launch option -netconport 2121)
bindsym $mod+Ctrl+t exec ~/.local/bin/cs2translate --write
{% endif %}
{% for cmd in s.autostart.extra %}
exec {{ cmd }}
{% endfor %}

# ── Your own tweaks ────────────────────────────────────
include {{ custom_conf }}
