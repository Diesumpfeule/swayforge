/* {{ mark }} – don't edit. Your own tweaks go into ~/.config/rofi/config.rasi
   Layout: {{ layout }} */

configuration {
    modi:                "drun,run,window";
    show-icons:          {{ "false" if layout == "wired" else "true" }};
    icon-theme:          "{{ icons }}";
    drun-display-format: "{name}";
    display-drun:        "{{ "> run" if layout == "wired" else "Apps" }}";
    display-run:         "{{ "> exec" if layout == "wired" else "Command" }}";
    display-window:      "{{ "> win" if layout == "wired" else "Windows" }}";
    terminal:            "{{ s.general.terminal }}";
}

* {
    bg:        {{ rgba(c.base, 0.96) }};
    bg-alt:    {{ c.surface }};
    fg:        {{ c.text }};
    fg-dim:    {{ c.subtext }};
    accent:    {{ c.accent }};
    on-accent: {{ c.crust }};
    urgent:    {{ c.red }};
    hi:        {{ bv.hi }};
    lo:        {{ bv.lo }};
    face:      {{ bv.face }};

    background-color: transparent;
    text-color:       @fg;
    font:             "{{ font }} {{ s.theme.font_size + 1 }}";
}

{% if layout == "win98" %}
/* ── Classic 98 start menu: bevelled box with a coloured side stripe ── */
window {
    location: south west;
    anchor: south west;
    x-offset: 3px;
    y-offset: 0;   /* rofi already sits above the bar's reserved space */
    width: 420px;
    background-color: @face;
    border: 2px 0 0 2px;
    border-color: @hi;
    children: [ frame ];
}
frame {
    border: 0 2px 2px 0;
    border-color: @lo;
    orientation: horizontal;
    children: [ textbox-stripe, mainbox ];
}
textbox-stripe {
    expand: false;
    width: 34px;
    background-color: {{ bv.title }};
    text-color: {{ c.crust }};
    content: "";
}
mainbox { padding: 6px; spacing: 6px; children: [ inputbar, listview ]; }
inputbar {
    background-color: {{ c.base }};
    border: 2px 0 0 2px; border-color: @lo;
    padding: 6px 8px; spacing: 8px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry  { placeholder: "Type to search …"; placeholder-color: @fg-dim; }
listview { lines: 12; columns: 1; spacing: 0; fixed-height: false; scrollbar: false; }
element { padding: 5px 8px; spacing: 10px; }
element selected.normal { background-color: {{ bv.title }}; text-color: {{ c.crust }}; }

{% elif layout == "winxp" %}
/* ── Luna XP start menu: blue header with the user name, light body, blue footer ── */
window {
    location: south west;
    anchor: south west;
    x-offset: 0px;
    y-offset: 0px;
    width: 500px;
    border: 2px;
    border-color: {{ c.accent }};
    border-radius: 9px 9px 0 0;
    background-color: {{ c.base }};
    padding: 0;
}
mainbox { spacing: 0; padding: 0; children: [ textbox-head, inputbar, listview, textbox-foot ]; }
textbox-head {
    expand: false;
    padding: 12px 14px;
    content: "  {{ user }}";
    font: "{{ font }} Bold {{ s.theme.font_size + 4 }}";
    text-color: #ffffff;
    border-radius: 7px 7px 0 0;
    background-color: {{ c.accent }};
    background-image: linear-gradient(to bottom, {{ mix(c.accent, "#ffffff", 0.3) }}, {{ mix(c.accent, "#000000", 0.08) }});
}
inputbar {
    margin: 8px 10px 4px 10px;
    padding: 6px 8px; spacing: 8px;
    background-color: {{ c.surface }};
    border: 1px; border-color: {{ c.surface2 }}; border-radius: 3px;
    children: [ prompt, entry ];
}
prompt { text-color: {{ c.accent2 }}; }
entry  { placeholder: "Search programs …"; placeholder-color: @fg-dim; }
listview { lines: 12; columns: 1; spacing: 1px; margin: 4px 10px 8px 10px; fixed-height: false; scrollbar: false; background-color: {{ c.surface }}; border: 1px; border-color: {{ c.surface2 }}; padding: 4px; }
element { padding: 6px 8px; spacing: 10px; border-radius: 0; }
element selected.normal { background-color: {{ c.accent2 }}; text-color: #ffffff; }
textbox-foot {
    expand: false;
    padding: 8px 14px;
    content: "  Turn off: right-click the Start button";
    text-color: #ffffff;
    background-color: {{ c.accent }};
    background-image: linear-gradient(to bottom, {{ c.accent }}, {{ mix(c.accent, "#000000", 0.2) }});
}

{% elif layout == "dread" %}
/* ── Dread: an item box – dark, rust-framed, list with a red marker, key hints at the bottom ── */
window {
    location: center;
    anchor: center;
    width: 540px;
    background-color: {{ c.crust }};
    border: 2px;
    border-color: {{ mix(c.accent, c.crust, 0.45) }};
    padding: 3px;
}
mainbox {
    border: 1px;
    border-color: {{ c.surface2 }};
    padding: 14px 16px;
    spacing: 10px;
    background-color: {{ c.base }};
    children: [ textbox-head, inputbar, listview, textbox-foot ];
}
textbox-head {
    expand: false; horizontal-align: 0.5;
    content: "▌ INVENTORY ▐";
    text-color: {{ c.accent }};
}
inputbar {
    padding: 6px 8px; spacing: 8px;
    background-color: {{ c.crust }};
    border: 0 0 1px 0; border-color: {{ c.surface2 }};
    children: [ prompt, entry ];
}
prompt { text-color: {{ c.accent }}; }
entry  { placeholder: "…"; placeholder-color: @fg-dim; }
listview { lines: 10; columns: 1; spacing: 2px; fixed-height: false; scrollbar: false; }
element { padding: 6px 10px; spacing: 10px; border: 0 0 0 3px; border-color: transparent; }
element selected.normal {
    background-color: {{ rgba(c.accent, 0.20) }};
    border-color: {{ c.accent }};
    text-color: {{ c.text }};
}
element normal.normal { text-color: @fg-dim; }
textbox-foot {
    expand: false; horizontal-align: 0.5;
    content: "[ Enter ] use     [ Esc ] close";
    text-color: {{ c.overlay }};
}

{% elif layout == "win7" %}
/* ── Glass 7 start menu ──────────────────────────────────────────── */
window {
    location: south west;
    anchor: south west;
    x-offset: 6px;
    y-offset: -8px;
    width: 460px;
    border: 1px;
    border-color: {{ rgba(c.text, 0.35) }};
    border-radius: 8px;
    background-color: {{ rgba(c.base, 0.96) }};
    background-image: linear-gradient(to bottom, {{ rgba(bv.hi, 0.75) }}, {{ rgba(c.crust, 0.96) }});
    padding: 12px;
}
mainbox { spacing: 10px; children: [ inputbar, listview ]; }
inputbar {
    background-color: {{ rgba(c.text, 0.10) }};
    border: 1px; border-color: {{ rgba(c.text, 0.25) }}; border-radius: 4px;
    padding: 7px 10px; spacing: 8px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry  { placeholder: "Search programs and files"; placeholder-color: @fg-dim; }
listview { lines: 12; columns: 1; spacing: 2px; fixed-height: false; scrollbar: false; }
element { padding: 6px 10px; spacing: 12px; border-radius: 4px; }
element selected.normal {
    background-image: linear-gradient(to bottom, {{ rgba(c.accent, 0.55) }}, {{ rgba(c.accent, 0.25) }});
    border: 1px; border-color: {{ rgba(c.accent, 0.8) }};
    text-color: @fg;
}

{% elif layout == "cathedral" %}
/* ── Cathedral: a framed book of hours – double frame, ornament header, serif ── */
* { font: "DejaVu Serif {{ s.theme.font_size + 1 }}"; }
window {
    width: 560px;
    background-color: {{ c.crust }};
    border: 3px;
    border-color: {{ c.accent }};
    padding: 5px;
}
mainbox {
    border: 1px;
    border-color: {{ rgba(c.text, 0.35) }};
    padding: 14px 18px;
    spacing: 10px;
    children: [ textbox-orn, inputbar, listview, textbox-foot ];
    background-color: {{ c.base }};
}
textbox-orn {
    expand: false; horizontal-align: 0.5;
    content: "☩ ❦ ───── ⚜ ───── ☠ ───── ⚜ ───── ❦ ☩";
    text-color: {{ c.accent }};
}
textbox-foot {
    expand: false; horizontal-align: 0.5;
    content: "† ❧ memento mori ❧ †";
    text-color: {{ c.overlay }};
}
inputbar {
    border: 0 0 1px 0; border-color: {{ rgba(c.text, 0.25) }};
    padding: 4px 2px 8px; spacing: 10px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry  { placeholder: "seek …"; placeholder-color: @fg-dim; }
listview { lines: 10; columns: 1; spacing: 2px; fixed-height: false; scrollbar: false; }
element { padding: 6px 10px; spacing: 12px; }
element normal.normal, element alternate.normal { text-color: {{ c.subtext }}; }
element selected.normal {
    background-color: {{ rgba(c.accent, 0.22) }};
    border: 0 0 0 3px; border-color: @accent;
    text-color: {{ c.text }};
}

{% elif layout == "win11" %}
/* ── Modern 11 start menu: centered above the taskbar, rounded ───────── */
window {
    location: south; anchor: south; y-offset: -12px;
    width: 600px;
    background-color: {{ rgba(c.mantle, 0.94) }};
    border: 1px; border-color: {{ rgba(c.text, 0.18) }};
    border-radius: 12px; padding: 18px;
}
mainbox { spacing: 14px; children: [ inputbar, listview ]; }
inputbar { background-color: @bg-alt; border-radius: 20px; border: 0 0 2px 0; border-color: @accent;
    padding: 10px 16px; spacing: 10px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry  { placeholder: "Type here to search"; placeholder-color: @fg-dim; }
listview { lines: 9; columns: 1; spacing: 2px; fixed-height: false; scrollbar: false; }
element { padding: 9px 12px; spacing: 14px; border-radius: 8px; }
element selected.normal { background-color: {{ rgba(c.text, 0.12) }}; text-color: @fg; border: 0 0 0 3px; border-color: @accent; }

{% elif layout == "touch" %}
/* ── Touch: full-width sheet, big rows, 3 columns of app tiles ───────── */
* { font: "{{ font }} {{ s.theme.font_size + 6 }}"; }
window {
    location: south; anchor: south; width: 100%; height: 72%;
    background-color: {{ rgba(c.mantle, 0.98) }};
    border: 2px 0 0 0; border-color: @accent; padding: 24px;
}
mainbox { spacing: 20px; children: [ inputbar, listview ]; }
inputbar { background-color: @bg-alt; border-radius: 18px; padding: 18px 22px; spacing: 14px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry  { placeholder: "Search …"; placeholder-color: @fg-dim; }
listview { lines: 6; columns: 3; spacing: 12px; fixed-height: true; scrollbar: false; }
element { padding: 22px 20px; spacing: 18px; border-radius: 18px; background-color: @bg-alt; }
element selected.normal { background-color: @accent; text-color: @on-accent; }

{% elif layout == "wired" %}
/* ── Wired: a terminal prompt ────────────────────────────────────── */
window {
    width: 52%;
    background-color: {{ c.crust }};
    border: 1px;
    border-color: @accent;
    padding: 14px;
}
mainbox { spacing: 10px; children: [ inputbar, message, listview ]; }
inputbar { spacing: 10px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry  { placeholder: "_"; placeholder-color: @accent; cursor: text; }
message { border: 1px 0 0 0; border-color: {{ c.surface2 }}; padding: 6px 0; }
listview { lines: 12; columns: 1; spacing: 0; fixed-height: false; scrollbar: false; }
element { padding: 2px 6px; }
element normal.normal, element alternate.normal { text-color: {{ c.subtext }}; }
element selected.normal { background-color: transparent; text-color: @accent; border: 0 0 0 2px; border-color: @accent; }

{% elif layout == "glass" %}
/* ── Glass: compact centred box, rounded search, hairline selection ── */
window {
    width: 440px;
    background-color: {{ rgba(c.base, 0.82) }};
    border: 1px;
    border-color: {{ rgba(c.text, 0.16) }};
    border-radius: {{ s.look.radius }}px;
    padding: 12px;
}
mainbox { spacing: 12px; children: [ inputbar, message, listview ]; }
inputbar {
    background-color: @bg-alt;
    border-radius: {{ s.look.radius }}px;
    padding: 6px 15px;
    spacing: 12px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry  { placeholder: "Search"; placeholder-color: @fg-dim; cursor: text; text-color: @accent; }
message { background-color: transparent; padding: 4px 8px; text-color: @fg-dim; }
listview { lines: 7; columns: 1; fixed-height: true; scrollbar: false; spacing: 6px; padding: 4px 0; }
element { padding: 9px 14px; border: 1px; border-color: transparent; border-radius: {{ s.look.radius }}px; spacing: 14px; }
element selected.normal { background-color: {{ rgba(c.accent, 0.14) }}; text-color: @accent; border: 1px; border-color: @accent; }
element-icon { size: 28px; }

{% else %}
/* ── Modern / solid / minimal / sidebar ─────────────────────────── */
window {
{% if layout == "sidebar" %}
    location: west;
    anchor: west;
    x-offset: 10px;
{% endif %}
    width: 640px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: {{ s.look.radius }}px;
    padding: 16px;
}
mainbox { spacing: 12px; children: [ inputbar, message, listview ]; }
inputbar {
    background-color: @bg-alt;
    border-radius: {{ s.look.radius }}px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry  { placeholder: "Search …"; placeholder-color: @fg-dim; cursor: text; }
message { background-color: @bg-alt; border-radius: {{ s.look.radius }}px; padding: 10px; }
listview { lines: 8; columns: 1; fixed-height: false; scrollbar: false; spacing: 4px; }
element { padding: 8px 12px; border-radius: {{ [s.look.radius - 2, 0] | max }}px; spacing: 12px; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
{% endif %}

/* ── Shared ─────────────────────────────────────────────────────── */
textbox { text-color: @fg; }
element normal.normal, element alternate.normal { background-color: transparent; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element selected.urgent  { background-color: @urgent; text-color: @on-accent; }
element normal.active, element alternate.active { text-color: @accent; }
element selected.active  { background-color: @accent; text-color: @on-accent; }
element-icon { size: 1.3em; vertical-align: 0.5; }
element-text { text-color: inherit; vertical-align: 0.5; }
